# API Configuration
VITE_API_URL=http://localhost:5000

# Realtime Communication Configuration
# Provider options: 'signalr' | 'nats' | 'both'
# - 'signalr': Use only SignalR (default, backward compatible)
# - 'nats': Use only NATS
# - 'both': Prefer SignalR and fallback to NATS when SignalR fails
VITE_REALTIME_PROVIDER=both

# NATS Configuration
# Browser accepts ws:// or wss:// directly.
# It also accepts http:// or https:// and normalizes to ws:// / wss://.
# Legacy nats:// and tls:// values are accepted and normalized internally.
# If NATS is exposed by nginx in /nats, use the full public URL below.
VITE_NATS_URL=https://fqn.com.br/nats

# Enable/disable NATS (true by default if VITE_REALTIME_PROVIDER includes nats)
VITE_NATS_ENABLED=true

# Optional wildcard subject for direct heartbeat payloads (without dashboard.events envelope)
VITE_NATS_AGENT_HEARTBEAT_SUBJECT=tenant.*.site.*.agent.*.heartbeat

# Agent is considered offline if no heartbeat is seen within this window.
# Recommended: >= heartbeat interval (for example 60000 to 120000).
VITE_AGENT_OFFLINE_FALLBACK_MS=60000
