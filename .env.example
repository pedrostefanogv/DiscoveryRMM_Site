# API Configuration
# Em dev, deixe VITE_API_URL vazio/comentado para usar o proxy do Vite
# (vite.config.ts encaminha /api, /hubs, /openapi, /scalar e /nats para a API).
# Defina apenas quando o backend rodar em outra origem (ex.: produção):
# VITE_API_URL=https://sua-api.exemplo.com

# NATS Configuration
# Browser accepts ws:// or wss:// directly.
# It also accepts http:// or https:// and normalizes to ws:// / wss://.
# Legacy nats:// and tls:// values are accepted and normalized internally.
# Em dev, um caminho "/nats" resolve contra a origem do Vite (há proxy /nats
# no vite.config.ts apontando para o listener WebSocket do NATS).
VITE_NATS_URL=https://fqn.com.br/nats

# Enable/disable NATS
VITE_NATS_ENABLED=true

# Optional notifications subject template.
# Use placeholders: {userId} and {topic}
# Example: notifications.user.{userId}.topic.{topic}
VITE_NATS_NOTIFICATIONS_SUBJECT_TEMPLATE=

# Keep heartbeat metrics visible for this window after the last realtime update.
# Recommended for 30s heartbeat interval: 90000 (90s).
VITE_AGENT_HEARTBEAT_METRICS_TTL_MS=90000

# Agent is considered offline if no heartbeat is seen within this window.
# Recommended: >= heartbeat interval (for example 60000 to 120000).
VITE_AGENT_OFFLINE_FALLBACK_MS=60000
